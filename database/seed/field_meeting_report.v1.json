{
  "form_id": "field_meeting_report",
  "version": 1,
  "title": "Field Meeting Report",
  "sections": [
    {
      "id": "meeting_details",
      "title": "Meeting Details",
      "repeatable": true,
      "min_items": 1,
      "max_items": 10,
      "fields": [
        {"id": "contact_category", "key": "contact_category", "label": "Contact Category", "type": "text", "required": true, "validation": {"max_length": 100}},
        {"id": "contact_name", "key": "contact_name", "label": "Name of the Person Met", "type": "text", "required": true, "validation": {"max_length": 200}},
        {"id": "contact_whatsapp", "key": "contact_whatsapp", "label": "WhatsApp Number", "type": "phone", "required": false},
        {"id": "meeting_date", "key": "meeting_date", "label": "Meeting Date", "type": "date", "required": true},
        {"id": "meeting_description", "key": "meeting_description", "label": "Meeting Description", "type": "multiline_text", "required": true, "validation": {"max_length": 2000}},
        {"id": "meeting_photo", "key": "meeting_photo", "label": "Meeting Photo", "type": "photo", "required": false}
      ]
    }
  ]
}

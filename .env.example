# Copy to .env and change secrets. Never commit .env.
APP_ENV=development
POSTGRES_USER=fieldsync
POSTGRES_PASSWORD=fieldsync_dev
POSTGRES_DB=fieldsync
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://fieldsync:fieldsync_dev@localhost:5433/fieldsync

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Photo storage (local filesystem for now; S3 backend can be added later)
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage
FILE_URL_SECRET=change-me-too
FILE_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=15728640

# Internal form-configuration API (disabled when empty)
INTERNAL_API_KEY=

CORS_ORIGINS=http://localhost:5173

# Place names for coordinates (shown next to the GPS position in the admin web)
#   nominatim = free OpenStreetMap lookup: LIGHT USE ONLY, set a real contact email in the user agent
#   google    = Google Geocoding API, needs GOOGLE_MAPS_API_KEY (billing enabled)
#   none      = no place names
GEOCODER=nominatim
GEOCODER_USER_AGENT=FieldSync/0.1 (you@yourcompany.com)
GOOGLE_MAPS_API_KEY=

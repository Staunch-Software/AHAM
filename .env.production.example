# Copy to .env.prod (never commit it) and fill in every value.
# Generate secrets with:  openssl rand -hex 32

SITE_ADDRESS=app.example.com          # public hostname; Caddy gets a Let's Encrypt certificate for it.
                                      # Local HTTP-only test: SITE_ADDRESS=http://localhost with HTTP_PORT=8080 (do NOT put the port here)
PUBLIC_ORIGIN=https://app.example.com

POSTGRES_PASSWORD=
JWT_SECRET=
FILE_URL_SECRET=

# Leave empty unless you are publishing a form version through the internal API; remove again afterwards.
INTERNAL_API_KEY=

# Optional overrides
# POSTGRES_USER=fieldsync
# POSTGRES_DB=fieldsync
# HTTP_PORT=80
# HTTPS_PORT=443

# Place names (see docs/deployment.md). Public OpenStreetMap lookups are for light use only; set a real contact.
GEOCODER=nominatim
GEOCODER_USER_AGENT=FieldSync/1.0 (admin@yourcompany.com)
# For Google instead: GEOCODER=google and GOOGLE_MAPS_API_KEY=...
GOOGLE_MAPS_API_KEY=
